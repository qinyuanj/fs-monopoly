# ── 生成物 / 构建产物 ─────────────────────────────────────────────
# 全部由各自的正牌生产者重生成，永不版本化。
# 扫描/构建产物目录与标记文件。
/build/
*.luac
# 车道/工具日志残留兜底（仓根与子树都不版本化 .log）。
*.log
# luacov 残留防护：任何链路把 luacov 产物泄进仓根时，guards 的白名单检查会
# 报违规；gitignore 兜底保证 clean 前不把残留提交进来。
/luacov.report.out
/luacov.stats.out

# ── 外部 overlay 与编辑器缓存 ────────────────────────────────────
# Clojure 编辑器/linter 缓存兜底。
.clj-kondo/
.lsp/
# Claude Code 自身的 worktree 本地状态。
/.claude/worktrees/
# Claude Code 本地覆写（可能含 MCP token）。
.claude/settings.local.json

# ── 临时与本地草稿 ───────────────────────────────────────────────
# agent 的 scratch 面：./tmp/ 只放解析产物、dry 报告与 handoff 草稿。
/tmp/
*.tmp
*.bak

# ── 编辑器 / OS / 其他 agent 环境 ────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
~$*.docx
.vscode/
.idea/
.VSCodeCounter/
.venv/
.opencode
.sisyphus/
.omo/

# ── 运营本地密件 ─────────────────────────────────────────────────
# 礼包码明文发放记录(#203):码表只存哈希,明文永不入库,只在本机保留。
/.secrets/

# ── uml-viewer 质量入口(#93)───────────────────────────────────────
# crapper/mutator 的度量 .metrics/(crap.edn、mutate/*.edn)按上游 README 入库,
# 不在此忽略;只忽略覆盖率中间产物 target/coverage/(见 tools/specs/uml_quality.prompt)。
/target/
# get-uml-viewer 拷到仓根的 uml 不钉 LUA_PATH,会从全局 luarocks tree
# 解析出假绿;受支持的入口是 `lua5.4 tools/cli.lua uml`,这份拷贝不入库。
/uml
# `lua5.4 tools/cli.lua uml ir` 的生成物(ADR 0070 / #99):从 arch_policy 投影 +
# docs/architecture.proposals.edn 重生,不入库;推演只改覆盖文件。IR 写到已忽略的 tmp/uml/。
/policy.edn
# 下面这段由 get-uml-viewer 维护(重装时整段删除再追加到文件末尾),保持原样、保持在末尾。
# BEGIN UML-VIEWER
.uml-viewer/
uml-viewer-log.txt
# END UML-VIEWER
